# Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/insurance-vault

# Firebase Admin SDK
# Download your service account key from Firebase Console > Project Settings > Service Accounts
# Copy the entire JSON and paste here as a single-line string
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Optional: AI/ML Configuration
# For Claude API integration
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Cloud Storage (if using AWS S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=insurance-vault-files

# Optional: Encryption
ENCRYPTION_KEY=your-32-char-encryption-key-here
