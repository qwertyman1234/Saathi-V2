# Backend Environment Variables - Local Development

# Server Configuration
PORT=5000
NODE_ENV=development

# Database - Local MongoDB
MONGODB_URI=mongodb://localhost:27017/insurance-vault

# Firebase Admin SDK - IMPORTANT: Update with your actual credentials
# 1. Go to Firebase Console > Project Settings > Service Accounts
# 2. Click "Generate New Private Key"
# 3. Copy the JSON and replace the placeholder below
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"saathi-health-insurance","private_key":"-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQDN+example+key+\nhere+replace+with+actual+key\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xyz@saathi-health-insurance.iam.gserviceaccount.com","client_id":"123456789","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/..."}

# Optional: AI/ML Configuration
# For Claude API integration (leave empty for mock extraction during testing)
ANTHROPIC_API_KEY=

# Optional: Cloud Storage (if using AWS S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=insurance-vault-files

# Optional: Encryption Key (for document encryption, 32 character minimum)
ENCRYPTION_KEY=your32characterencryptionkeyhere1234
